choice = input("Enter 1 for gift hub or 2 for Band Name:")


if choice =="1":
    print("Welcome to the Gift Hub Dashboard!")
    username  = input("Enter your username:\n")
    budget_limit = input("What is your monthly gifting budget(in R)n")
    print(f"Welcome back, {username}! Budget tracking active ar R{budget_limit}.")
    friend = input("who are you buying a gift for?\n")
    gift = input(f"What gift idea do you have for?\n")
    print(f"saved! Your gift idea for {friend} is {gift}")

elif choice == "2":
      city = input("What is the name of the city you grew up in?\n")
      pet = input("What is the name of your pet?\n")
      print(f"Your band name could be: The {city} {pet}")
      len(pet)
      len(city)
      print(f"Your city lenghth is:{len(city)}")
      print(f"Your pet lenghth is: {len(pet)}")